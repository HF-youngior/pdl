      }
    },
    "/api/tasks/{id}/request": {
      "put": {
        "summary": "更新邀约任务信息",
        "tags": ["任务模块"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
