{
  "openapi": "3.0.0",
  "info": {
    "title": "潘多拉企业管理系统 API",
    "version": "1.0.0",
    "description": "公司重要事项、任务、日历视图、签到积分、日志、AI 分析等接口文档（Swagger UI 版）"
  },
  "tags": [
    { "name": "认证与用户", "description": "登录、用户、部门相关接口" },
    { "name": "重要事项", "description": "重要事项库与公司重要事项管理" },
    { "name": "任务模块", "description": "任务 CRUD、状态、邀约等接口" },
    { "name": "日历视图", "description": "任务日历与视图相关接口" },
    { "name": "通知", "description": "消息通知与提醒" },
    { "name": "签到与积分", "description": "签到记录、积分、兑换相关接口" },
    { "name": "文件上传", "description": "图片等文件上传接口" },
    { "name": "日志与个人信息", "description": "个人日志、个人信息、系统日志" },
    { "name": "MBTI", "description": "MBTI 测评记录与统计" },
    { "name": "AI 分析", "description": "AI 文本分析与人格分析" },
    { "name": "文档", "description": "API 文档页面接口" }
  ],
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地开发环境"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "在 Authorization 头中传入 Bearer Token，例如：`Bearer xxx.yyy.zzz`"
      }
    },
    "schemas": {
      "CompanyImportantItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "string" },
          "status": { "type": "string" },
          "deadline": { "type": "string", "format": "date-time" },
          "is_selected": { "type": "boolean" },
          "created_by_name": { "type": "string" },
          "updated_by_name": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/important-items": {
      "get": {
        "summary": "获取重要事项库列表（已选中）",
        "tags": ["重要事项"],
        "description": "返回所有被标记为已选中的重要事项，用于前端展示。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "description": { "type": "string" },
                      "is_selected": { "type": "boolean" },
                      "created_by_name": { "type": "string" },
                      "updated_by_name": { "type": "string" },
                      "created_at": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/company-important-items": {
      "get": {
        "summary": "获取公司十大重要事项（仅已选中）",
        "tags": ["重要事项"],
        "description": "返回已被选中用于展示的公司重要事项列表。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CompanyImportantItem" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "创建或选中公司重要事项",
        "tags": ["重要事项"],
        "description": "支持两种方式：1）传入 item_id，将已有事项标记为选中；2）直接传入 title/description 等字段创建一条新事项。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item_id": {
                    "type": "string",
                    "description": "从重要事项库选择的 ID"
                  },
                  "title": {
                    "type": "string",
                    "description": "直接创建时的标题"
                  },
                  "description": {
                    "type": "string",
                    "description": "描述"
                  },
                  "priority": {
                    "type": "string",
                    "description": "优先级，例如 p0/p1"
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date-time",
                    "description": "截止日期"
                  }
                }
              },
              "example": {
                "item_id": "1"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "从重要事项库选中成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "id": { "type": "string" }
                  }
                },
                "example": {
                  "message": "重要事项添加成功",
                  "id": "1"
                }
              }
            }
          },
          "201": {
            "description": "直接创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "id": { "type": "string" }
                  }
                },
                "example": {
                  "message": "创建成功",
                  "id": "generated-uuid"
                }
              }
            }
          }
        }
      }
    },
    "/api/company-important-items/all": {
      "get": {
        "summary": "获取所有公司重要事项（用于编辑）",
        "tags": ["重要事项"],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CompanyImportantItem" }
                }
              }
            }
          }
        }
      }
    },
    "/api/company-important-items/{id}/select": {
      "put": {
        "summary": "更新单个公司重要事项的选中状态",
        "tags": ["重要事项"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "公司重要事项 ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "is_selected": {
                    "type": "boolean",
                    "description": "是否选中"
                  }
                },
                "required": ["is_selected"]
              },
              "example": { "is_selected": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      }
    },
    "/api/company-important-items/batch-select": {
      "put": {
        "summary": "批量更新公司重要事项选中状态（设置十大重要事项）",
        "tags": ["重要事项"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "selectedIds": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["selectedIds"]
              },
              "example": {
                "selectedIds": ["id1", "id2", "id3"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "批量更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "selectedCount": { "type": "integer" },
                    "totalCount": { "type": "integer" }
                  }
                },
                "example": {
                  "message": "批量更新成功",
                  "selectedCount": 3,
                  "totalCount": 3
                }
              }
            }
          }
        }
      }
    },
    "/api/company-important-items/{id}": {
      "put": {
        "summary": "更新指定公司重要事项的信息",
        "tags": ["重要事项"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "公司重要事项 ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "priority": { "type": "string" },
                  "status": { "type": "string" },
                  "deadline": { "type": "string", "format": "date-time" }
                }
              },
              "example": {
                "title": "更新后的标题",
                "description": "更新后的描述"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          },
          "404": {
            "description": "公司重要事项不存在"
          }
        }
      },
      "delete": {
        "summary": "删除指定公司重要事项",
        "tags": ["重要事项"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "公司重要事项 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/api": {
      "get": {
        "summary": "API 文档首页",
        "tags": ["文档"],
        "description": "返回自定义 HTML API 文档页面。",
        "responses": {
          "200": {
            "description": "HTML 文档页面"
          }
        }
      }
    },
    "/api/old": {
      "get": {
        "summary": "旧版 API 文档页",
        "tags": ["文档"],
        "responses": {
          "200": {
            "description": "旧版 HTML 文档页面"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "用户登录",
        "tags": ["认证与用户"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["username", "password"]
              },
              "example": {
                "username": "admin",
                "password": "admin123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功，返回 JWT token"
          }
        }
      }
    },
    "/api/user/profile": {
      "get": {
        "summary": "获取当前登录用户信息",
        "tags": ["认证与用户"],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
    "/api/departments": {
      "get": {
        "summary": "获取部门列表",
        "tags": ["认证与用户"],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "获取用户列表",
        "tags": ["认证与用户"],
        "responses": {
          "200": { "description": "成功" }
        }
      },
      "post": {
        "summary": "创建用户",
        "tags": ["认证与用户"],
        "responses": {
          "201": { "description": "创建成功" }
        }
      }
    },
    "/api/users/{id}": {
      "put": {
        "summary": "更新用户信息",
        "tags": ["认证与用户"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "更新成功" }
        }
      },
      "delete": {
        "summary": "删除用户",
        "tags": ["认证与用户"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "删除成功" }
        }
      }
    },
    "/api/auth/change-password": {
      "put": {
        "summary": "修改密码",
        "tags": ["认证与用户"],
        "responses": {
          "200": { "description": "修改成功" }
        }
      }
    },
    "/api/admin/dashboard-stats": {
      "get": {
        "summary": "获取仪表盘统计数据",
        "tags": ["系统管理"],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "summary": "获取任务列表",
        "tags": ["任务模块"],
        "responses": {
          "200": { "description": "成功" }
        }
      },
      "post": {
        "summary": "创建任务",
        "tags": ["任务模块"],
        "responses": {
          "201": { "description": "创建成功" }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "summary": "获取任务详情",
        "tags": ["任务模块"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      },
      "put": {
        "summary": "更新任务",
        "tags": ["任务模块"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "更新成功" }
        }
      },
      "delete": {
        "summary": "删除任务",
        "tags": ["任务模块"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "删除成功" }
        }
      }
    },
    "/api/tasks/{id}/status": {
      "put": {
        "summary": "更新任务状态",
        "tags": ["任务模块"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "更新成功" }
        }
      }
    },
    "/api/tasks/request": {
