          "200": { "description": "更新成功" }
        }
      }
    },
    "/api/tasks/{id}/request-response": {
      "put": {
        "summary": "处理邀约任务回应",
        "tags": ["任务模块"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "处理成功" }
        }
      }
    },
    "/api/notifications": {
