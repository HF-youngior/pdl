    "/api/mbti-records": {
      "post": {
        "summary": "创建 MBTI 测评记录",
        "tags": ["MBTI"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mbti_type", "test_scores", "personality_traits"],
                "properties": {
                  "mbti_type": {
                    "type": "string",
                    "description": "MBTI类型，格式为4个字符，如ENFP",
                    "example": "ENFP"
                  },
                  "test_scores": {
                    "type": "object",
                    "description": "测试分数，包含8个维度",
                    "properties": {
                      "E": { "type": "number", "example": 75 },
                      "I": { "type": "number", "example": 25 },
                      "S": { "type": "number", "example": 20 },
                      "N": { "type": "number", "example": 80 },
                      "T": { "type": "number", "example": 30 },
                      "F": { "type": "number", "example": 70 },
                      "J": { "type": "number", "example": 35 },
                      "P": { "type": "number", "example": 65 }
                    }
                  },
                  "personality_traits": {
                    "type": "object",
                    "description": "性格特质",
                    "example": {
                      "extroversion": "外向型，善于社交和沟通",
                      "intuition": "直觉型，喜欢探索新可能性",
                      "feeling": "情感型，重视人际关系和价值观",
                      "perceiving": "感知型，灵活适应环境变化"
                    }
                  },
                  "personal_info": {
                    "type": "object",
                    "description": "个人信息（可选）",
                    "example": {
                      "full_name": "测试用户",
                      "birth_date": "1990-01-01",
                      "address": "测试地址"
                    }
                  },
                  "test_version": {
                    "type": "string",
                    "description": "测试版本（可选，默认v1.0）",
                    "example": "v1.0"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "创建成功" },
          "400": { "description": "请求参数错误" },
          "401": { "description": "未认证" }
        }
      },
      "get": {
        "summary": "获取 MBTI 测评记录列表",
        "tags": ["MBTI"],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
