{
	"info": {
		"_postman_id": "unauthorized-access-test-001",
		"name": "越权访问控制安全测试",
		"description": "测试普通用户无法访问管理员专用接口。验证权限控制机制是否有效。",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. 普通用户登录获取Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"状态码为200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"保存Token到变量\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.token) {",
							"        pm.collectionVariables.set(\"employee_token\", jsonData.token);",
							"        pm.collectionVariables.set(\"employee_role\", jsonData.user.role);",
							"        pm.collectionVariables.set(\"employee_id\", jsonData.user.id);",
							"        console.log(\"✓ Token已保存\");",
							"        console.log(\"✓ 用户角色:\", jsonData.user.role);",
							"        console.log(\"✓ 用户ID:\", jsonData.user.id);",
							"    }",
							"});",
							"",
							"pm.test(\"用户角色为employee\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.user.role).to.equal('employee');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"test_employee\",\n    \"password\": \"test123456\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "使用普通员工账户登录，获取JWT Token。"
			},
			"response": []
		},
		{
			"name": "2. 验证Token可以访问普通接口",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"状态码为200（Token有效）\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"响应包含用户信息\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('username');",
							"    console.log(\"✓ 普通接口访问成功（符合预期）\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{employee_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/user/profile",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"user",
						"profile"
					]
				},
				"description": "使用普通用户Token访问用户信息接口，验证Token有效且可以访问普通接口。"
			},
			"response": []
		},
		{
			"name": "3. 尝试访问管理员仪表盘统计（应被拒绝）",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"状态码为403（权限不足）\", function () {",
							"    pm.response.to.have.status(403);",
							"});",
							"",
							"pm.test(\"错误消息为'权限不足'\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('error');",
							"    pm.expect(jsonData.error).to.include('权限不足');",
							"    console.log(\"✓ 权限控制有效：普通用户无法访问管理员接口\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{employee_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/admin/dashboard-stats",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"admin",
						"dashboard-stats"
					]
				},
				"description": "使用普通用户Token尝试访问管理员仪表盘统计接口。\n\n预期结果：\n- 状态码：403 Forbidden\n- 响应：{\"error\": \"权限不足\"}\n\n这证明权限控制机制有效。"
			},
			"response": []
		},
