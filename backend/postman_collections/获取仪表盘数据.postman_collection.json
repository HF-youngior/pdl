				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1. 断言状态码为 200 OK\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// 2. 验证返回的数据结构和字段\r",
							"var jsonData = pm.response.json();\r",
							"pm.test(\"Verify Dashboard Stats Fields\", function () {\r",
							"    // 验证包含所有必要的统计字段\r",
							"    pm.expect(jsonData).to.have.property(\"totalUsers\");\r",
							"    pm.expect(jsonData).to.have.property(\"totalImportantItems\");\r",
							"    pm.expect(jsonData).to.have.property(\"pendingTasks\");\r",
							"    pm.expect(jsonData).to.have.property(\"todayLogs\");\r",
							"});\r",
							"\r",
							"// 3. 验证字段值为数字 (通用验证)\r",
							"pm.test(\"Values are numbers\", function () {\r",
							"    pm.expect(jsonData.totalUsers).to.be.a('number');\r",
							"    pm.expect(jsonData.pendingTasks).to.be.a('number');\r",
							"});\r",
							"\r",
							"// 4. (可选) 严格匹配 PDF 中的预期值 \r",
							"// 如果你的数据库数据和 PDF 截图完全一致，可以启用下面这段：\r",
							"/*\r",
							"pm.test(\"Verify Exact Values (Optional)\", function () {\r",
							"    pm.expect(jsonData.totalUsers).to.eql(26);\r",
							"    pm.expect(jsonData.totalImportantItems).to.eql(4);\r",
							"    pm.expect(jsonData.pendingTasks).to.eql(70);\r",
							"    pm.expect(jsonData.todayLogs).to.eql(0);\r",
							"});\r",
							"*/"
